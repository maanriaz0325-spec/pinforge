# PinForge Environment Configuration

# Database: SQLite by default for zero-friction local dev; switch to PostgreSQL in docker if preferred
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://pinforge:pinforge_secret_pw@localhost:5432/pinforge?schema=public"

# AES-256-GCM Master Key (64-character hex string)
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Provider Mode: "mock" (default, runs tests & simulates realistic payloads) or "live"
PROVIDER_MODE="mock"

# Optional Pre-filled Provider Keys (or set them via the Settings UI)
RUNWARE_API_KEY=""
OPENROUTER_API_KEY=""

# Application Port
PORT=3005
